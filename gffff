-- Compatibility shim: provide safe in-memory fallbacks for exploit-only file APIs
do
	local __FS = {}
	if not writefile then
		writefile = function(path, content) __FS[path] = tostring(content) end
	end
	if not readfile then
		readfile = function(path) return __FS[path] end
	end
	if not isfile then
		isfile = function(path) return __FS[path] ~= nil end
	end
	if not isfolder then
		isfolder = function(path)
			path = path:gsub("\\", "/")
			for k, _ in pairs(__FS) do
				local k2 = k:gsub("\\", "/")
				if k2:sub(1, #path) == path then return true end
			end
			return false
		end
	end
	if not makefolder then
		makefolder = function(path) __FS[path] = __FS[path] or "__folder" end
	end
	if not listfiles then
		listfiles = function(path)
			local out = {}
			path = path:gsub("\\", "/")
			for k, _ in pairs(__FS) do
				local k2 = k:gsub("\\", "/")
				if k2:sub(1, #path) == path then table.insert(out, k) end
			end
			return out
		end
	end
end
